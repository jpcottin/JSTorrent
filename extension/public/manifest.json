{
  "manifest_version": 3,
  "name": "JSTorrent",
  "version": "1.1.0",
  "description": "BitTorrent client for Chrome. Download torrents directly from your browser.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "notifications",
    "unlimitedStorage",
    "contextMenus"
  ],
  "optional_permissions": ["power"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {},
  "icons": {
    "16": "icons/js-16.png",
    "32": "icons/js-32.png",
    "128": "icons/js-128.png"
  },
  "host_permissions": ["http://100.115.92.2/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "sandbox": {
    "pages": ["search-plugin-sandbox.html"]
  },
  "externally_connectable": {
    "ids": [
      "anhdpjpojoipgpmfanmedjghaligalgb",
      "abmohcnlldaiaodkpacnldcdnjjgldfh",
      "bnceafpojmnimbnhamaeedgomdcgnbjk"
    ],
    "matches": [
      "https://new.jstorrent.com/*",
      "https://jstorrent.com/*",
      "http://local.jstorrent.com/*"
    ]
  }
}
