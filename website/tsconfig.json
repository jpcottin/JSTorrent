{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@jstorrent/engine": ["../packages/engine/src"],
      "@jstorrent/engine/*": ["../packages/engine/src/*"],
      "@jstorrent/client/core": ["../packages/client/src/core"],
      "@jstorrent/client": ["../packages/client/src"],
      "@jstorrent/client/*": ["../packages/client/src/*"],
      "@jstorrent/ui/piece-visualization": ["../packages/ui/src/components/PieceVisualization.tsx"],
      "@jstorrent/ui": ["../packages/ui/src"],
      "@jstorrent/ui/*": ["../packages/ui/src/*"]
    }
  },
  "include": ["src"]
}
