{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@jstorrent/engine": ["../../packages/engine/src"],
      "@jstorrent/engine/*": ["../../packages/engine/src/*"],
      "@jstorrent/client/core": ["../../packages/client/src/core"],
      "@jstorrent/client": ["../../packages/client/src"],
      "@jstorrent/client/*": ["../../packages/client/src/*"],
      "@jstorrent/ui": ["../../packages/ui/src"],
      "@jstorrent/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
