{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSTorrent",
  "version": "0.1.20",
  "identifier": "com.jstorrent.desktop",
  "build": {
    "beforeDevCommand": "pnpm prepare-sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSTorrent",
        "width": 1024,
        "height": 700,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/jstorrent-host",
      "binaries/jstorrent-io-daemon"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "mimeType": "application/x-bittorrent",
        "description": "BitTorrent file"
      }
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Kyle Graehl (VD7BYQ6ABM)"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/kzahel/JSTorrent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNUQzREY0QjNEMENGQjgKUldTNHo5Q3o5RDFkUWRwNnpxMTR2UnBiUFVGejlaYnpIU0t2bkJYanBTenBZMFR0a0J5WUU3SzIK"
    }
  }
}
