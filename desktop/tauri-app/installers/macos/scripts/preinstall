#!/bin/bash
# Preinstall script for JSTorrent Desktop .pkg installer
# Kills any running JSTorrent processes before installation.

pkill -x "JSTorrent" 2>/dev/null || true
pkill -x "jstorrent-host" 2>/dev/null || true
pkill -x "jstorrent-io-daemon" 2>/dev/null || true
# Give processes time to exit
sleep 0.5

exit 0
